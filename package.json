  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vite": "^8.2.2"
