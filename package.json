{
  "name": "@wzhooh/vite-plugin",
  "version": "0.0.4",
  "description": "Vite plugin for Wzhooh applications running in sandboxed iframes",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "vite",
    "vite-plugin",
    "hmr",
    "live-preview",
    "wzhooh"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && npm run test:types && vitest run",
    "test:coverage": "npm run build && npm run test:types && vitest run --coverage",
    "test:types": "tsc -p test/tsconfig.json",
    "prepublishOnly": "npm run test:coverage"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "peerDependencies": {
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.11",
    "@types/node": "26.2.0",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
