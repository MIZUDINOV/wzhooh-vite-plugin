{
  "name": "@wzhooh/vite-plugin",
  "version": "0.0.1",
  "description": "Vite plugin for Wzhooh applications running in sandboxed iframes",
  "type": "module",
  "keywords": [
    "vite",
    "vite-plugin",
    "hmr",
    "live-preview",
    "wzhooh"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/MIZUDINOV/wzhooh-back.git",
    "directory": "infra/e2b-template/host/vite-plugin"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": "./dist/index.mjs",
